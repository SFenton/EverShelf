      "sideEffect": "github",
      "environment": []
    },
    {
      "id": "observe-release-disabled",
      "kind": "disabled",
      "reason": "Automatic GitHub Release observation driver is not implemented",
      "sideEffect": "github",
      "environment": []
    },
    {
      "id": "verify-release-disabled",
      "kind": "disabled",
      "reason": "GitHub Release and runtime verification driver is not implemented",
      "sideEffect": "production",
      "environment": []
    },
    {
      "id": "rollback-release-disabled",
      "kind": "disabled",
      "reason": "GitHub release rollback driver is not implemented",
      "sideEffect": "github",
      "environment": []
    },
    {
      "id": "rollback-git-disabled",
      "kind": "disabled",
