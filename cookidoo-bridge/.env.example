# Default-off metadata-v3 operator gate. Enable only with the matching
# EverShelf flag; persisted factual rows remain metadata-v2.
# Provider responses may include official steps, but the bridge projects only
# bounded factual metadata and never returns, logs, or stores instruction text.
COOKIDOO_DETAIL_HYDRATION_ENABLED=false
# Password login uses the upstream client and is disabled by default. Normal
# operation verifies and uses the persisted cookie in /data.
COOKIDOO_PASSWORD_LOGIN_ENABLED=false
COOKIDOO_EMAIL=
COOKIDOO_PASSWORD=

# Must match COOKIDOO_BRIDGE_TOKEN in EverShelf's main .env.
COOKIDOO_BRIDGE_TOKEN=

# Prefer an exact regional/script locale; language-only requests resolve to an effective locale.
COOKIDOO_DEFAULT_LOCALE=en-GB
COOKIDOO_COOKIE_PATH=/data/cookies.json
COOKIDOO_REQUEST_TIMEOUT_SECONDS=45
COOKIDOO_UPSTREAM_TIMEOUT_SECONDS=12
COOKIDOO_RATE_LIMIT_PER_MINUTE=10
COOKIDOO_MAX_CONCURRENCY=1
COOKIDOO_DETAIL_CONCURRENCY=1
COOKIDOO_MAX_RESULTS=20
# Separate default-off account planner gate. "unknown" suppresses capability
# and refuses writes. Set append/replace only after fake/staging verification
# of the provider's current PUT behavior; never infer it from a successful call.
COOKIDOO_PLANNER_WRITE_ENABLED=false
COOKIDOO_PLANNER_PUT_SEMANTICS=unknown
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8081
LOG_LEVEL=INFO
