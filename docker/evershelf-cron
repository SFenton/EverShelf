# EverShelf background jobs.
#
# cron_smart_shopping.php drives shopping predictions, shelf-life pre-warming AND the
# canonical/taxonomy enrichment queue. Without this file the queue fills up on every
# product save and never drains, so new items silently never receive taxonomy terms.
#
# Runs as www-data so anything written under data/ keeps the expected ownership.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/5 * * * * www-data sleep 30 && flock -n /var/www/html/data/.background-writer.lock php /var/www/html/api/cron_smart_shopping.php >> /var/www/html/data/cron.log 2>&1
# The shared-lock rebuild preserves an active v3 ontology/version and fails closed.
* * * * * www-data flock -n /var/www/html/data/.background-writer.lock php /var/www/html/scripts/rebuild-recipe-scores.php >> /var/www/html/data/cron.log 2>&1
* * * * * www-data sleep 15 && flock -n /var/www/html/data/.background-writer.lock php /var/www/html/scripts/process-recipe-queue.php --limit=2 --max-attempts=3 --respect-cookidoo-cadence >> /var/www/html/data/cron.log 2>&1
* * * * * www-data sleep 45 && flock -n /var/www/html/data/.background-writer.lock php /var/www/html/scripts/process-shopping-classification-queue.php --limit=1 >> /var/www/html/data/cron.log 2>&1
47 4 * * * www-data flock -w 120 /var/www/html/data/.background-writer.lock php /var/www/html/api/cron_maintenance.php >> /var/www/html/data/cron.log 2>&1
17 4 * * * www-data find /var/www/html/data/cron.log -size +5M -delete
