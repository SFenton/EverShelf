# EverShelf — Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All settings here can also be changed from the in-app Settings screen and
# will be written back to this file automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime environment ──────────────────────────────────────────────────────
# Keep production/default as production. Only isolated development/test
# instances may enable RECIPE_SCORE_PREVIEW_REVISION_ID.
EVERSHELF_ENV=production
# Required when building with Docker Compose. Set it from
# `git rev-parse HEAD`; release images reject non-SHA provenance.
EVERSHELF_BUILD_SHA=

# SQLite writers wait through bounded score-publication reservations.
SQLITE_BUSY_TIMEOUT_MS=1500

# Sparse score and identity work is capped at the production-validated size.
RECIPE_SCORE_INCREMENTAL_PRODUCT_LIMIT=250

# ── AI ────────────────────────────────────────────────────────────────────────
# Google Gemini API key (required for AI features: expiry reading, recipe gen, …)
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: smart storage-location classifier. Defaults prioritize quality.
LOCATION_AI_ENABLED=true
GEMINI_LOCATION_MODEL=gemini-3.6-flash
GEMINI_LOCATION_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: Gemini cost rates (USD per million tokens, for the Info tab cost estimate)
GEMINI_COST_36F_IN=1.50
GEMINI_COST_36F_OUT=7.50
GEMINI_COST_35FL_IN=0.30
GEMINI_COST_35FL_OUT=2.50
GEMINI_COST_3F_IN=0.50
GEMINI_COST_3F_OUT=3.00
GEMINI_COST_25F_IN=0.15
GEMINI_COST_25F_OUT=0.60
GEMINI_COST_20F_IN=0.10
GEMINI_COST_20F_OUT=0.40

# ── Shopping list (Bring!) ────────────────────────────────────────────────────
# Credentials for the Bring! app (optional — app works without it)
BRING_EMAIL=
BRING_PASSWORD=

# ── Text-to-Speech (TTS) ─────────────────────────────────────────────────────
# Works with Home Assistant, a local TTS server, or any HTTP endpoint.
# TTS_ENABLED: master switch (true/false)
TTS_ENABLED=false
# TTS_URL: endpoint that receives the text payload
TTS_URL=
# TTS_TOKEN: Authorization token sent as Bearer header (or empty)
TTS_TOKEN=
# TTS_METHOD: HTTP method (POST or GET)
TTS_METHOD=POST
# TTS_AUTH_TYPE: how the token is sent (bearer | basic | none)
TTS_AUTH_TYPE=bearer
# TTS_CONTENT_TYPE: request Content-Type header
TTS_CONTENT_TYPE=application/json
# TTS_PAYLOAD_KEY: JSON key that carries the text (e.g. "message", "text")
TTS_PAYLOAD_KEY=message
# TTS_ENGINE: preferred browser TTS engine ('browser', 'server', 'custom') — optional
TTS_ENGINE=
# TTS_RATE / TTS_PITCH: speech rate and pitch multipliers (1 = normal)
TTS_RATE=1
TTS_PITCH=1
# TTS_AUTH_HEADER_NAME / VALUE: custom HTTP header for authentication (optional)
TTS_AUTH_HEADER_NAME=
TTS_AUTH_HEADER_VALUE=
# TTS_EXTRA_FIELDS: additional JSON fields as key=value pairs, comma-separated (optional)
TTS_EXTRA_FIELDS=

# ── User preferences ─────────────────────────────────────────────────────────
# These mirror the toggle switches in the Settings screen.
DEFAULT_PERSONS=1
PREF_VELOCE=false
PREF_POCAFAME=false
PREF_SCADENZE=true
PREF_HEALTHY=false
PREF_OPENED=true
PREF_ZEROWASTE=false
# Dietary restrictions shown to the AI (e.g. "vegetariano,senza glutine")
DIETARY=

# ── Appliances ────────────────────────────────────────────────────────────────
# Comma-separated list of appliances available in your kitchen.
# Used by the AI when generating recipes.
APPLIANCES=Forno,Microonde,Friggitrice ad aria,Pentola a pressione

# ── Camera ───────────────────────────────────────────────────────────────────
# Default camera for barcode scanning ('environment' = rear, 'user' = front)
CAMERA_FACING=environment

# ── Smart Kitchen Scale ───────────────────────────────────────────────────────
# SCALE_ENABLED: enables the scale integration
SCALE_ENABLED=false
# SCALE_GATEWAY_URL: address of the EverShelf Scale Gateway (Android app)
SCALE_GATEWAY_URL=

# ── Meal Plan ────────────────────────────────────────────────────────────────
# MEAL_PLAN_ENABLED: show the weekly meal planner tab in Settings
MEAL_PLAN_ENABLED=false

# ── Screensaver (kiosk / tablet mode) ────────────────────────────────────────
SCREENSAVER_ENABLED=false
# SCREENSAVER_TIMEOUT: inactivity seconds before screensaver activates (default 5 min)
SCREENSAVER_TIMEOUT=300

# ── Price estimates ───────────────────────────────────────────────────────────
# PRICE_ENABLED: show AI-estimated price column on the shopping list
PRICE_ENABLED=false
# PRICE_COUNTRY: country used for price context (e.g. "Italia", "Germany")
PRICE_COUNTRY=Italia
# PRICE_CURRENCY: ISO 4217 currency code (e.g. EUR, USD, GBP)
PRICE_CURRENCY=EUR
# PRICE_UPDATE_MONTHS: how many months to cache a price before re-fetching (default 3)
PRICE_UPDATE_MONTHS=3

# ── Canonical ingredient taxonomy links (FoodOn via EBI OLS) ─────────────────
# FOODON_ENABLED: enrich canonical ingredients with FoodOn IDs (true/false)
FOODON_ENABLED=true
# FOODON_LOOKUP_ON_SAVE: run cached FoodOn lookup when saving new/edited products
FOODON_LOOKUP_ON_SAVE=true
# FOODON_MIN_REQUEST_INTERVAL_MS: minimum delay between uncached OLS requests
FOODON_MIN_REQUEST_INTERVAL_MS=250
# FOODON_CACHE_TTL_DAYS: refresh successful/miss cache entries after N days
FOODON_CACHE_TTL_DAYS=30
# Transient hierarchy failures retry sooner than definitive misses.
FOODON_HIERARCHY_FAILURE_CACHE_TTL_SECONDS=900
# FOODON_TIMEOUT_SEC: per-request timeout for EBI OLS
FOODON_TIMEOUT_SEC=6

# USDA FoodData Central canonical food/nutrition references.
# Requires a free API key from https://fdc.nal.usda.gov/api-key-signup.html
# (DEMO_KEY is heavily rate-limited and not recommended for backfills).
USDA_FDC_ENABLED=true
USDA_FDC_API_KEY=
USDA_FDC_LOOKUP_ON_SAVE=true
USDA_FDC_MIN_REQUEST_INTERVAL_MS=4000
USDA_FDC_CACHE_TTL_DAYS=30
USDA_FDC_TIMEOUT_SEC=8

# Canonical ingredient post-processing queue.
# product_save returns after persisting the product, then cron/CLI processes
# canonical aliases plus FoodOn/USDA enrichment in the background.
# The Docker image runs all workers itself. Non-Docker installs must configure the
# canonical, recipe-score, and recipe-queue cron commands documented in README.
CANONICAL_QUEUE_CRON_LIMIT=3
CANONICAL_QUEUE_CLI_LIMIT=20
CANONICAL_QUEUE_WORKER_LIMIT=5
CANONICAL_QUEUE_WORKER_MAX_BATCHES=100
CANONICAL_QUEUE_MAX_ATTEMPTS=3
CANONICAL_QUEUE_CRASH_LEASE_SECONDS=120
# Deprecated compatibility key. Legacy 600 is treated as the old sample and
# upgrades to 120; deliberate 600-second leases use the new key above.
# CANONICAL_QUEUE_LEASE_SECONDS=
CANONICAL_QUEUE_APPLY_RESERVE_SECONDS=30
CANONICAL_QUEUE_BUSY_TIMEOUT_MS=250
CANONICAL_QUEUE_APPLY_RETRY_SECONDS=20
CANONICAL_QUEUE_RELEASE_RETRY_SECONDS=45
CANONICAL_QUEUE_STALE_DUE_SECONDS=300
CANONICAL_QUEUE_LOCK_WARNING_INTERVAL_SECONDS=60
# The resident worker listens for fire-and-forget datagrams and falls back to
# this slow safety poll when a wake is dropped.
CANONICAL_QUEUE_WAKE_SOCKET=/var/www/html/data/canonical-queue.sock
CANONICAL_QUEUE_SAFETY_POLL_SECONDS=30

# Latency-critical local recipe jobs use a resident datagram-woken worker.
# Cookidoo discovery remains on the separately rate-limited provider cron.
RECIPE_QUEUE_WAKE_SOCKET=/var/www/html/data/recipe-queue.sock
RECIPE_QUEUE_LOCAL_POLL_MS=1000
RECIPE_QUEUE_LOCAL_LIMIT=20
RECIPE_QUEUE_LOCAL_MAX_ATTEMPTS=20
RECIPE_QUEUE_LOCAL_LEASE_SECONDS=120
RECIPE_QUEUE_WORKER_MEMORY_LIMIT=256M

# Legacy v2 model review is permanently observation-only. Enabling this flag
# records that a legacy review was requested, but it never calls a model or writes
# unversioned taxonomy nodes/edges.
TAXONOMY_AI_REVIEW=false

# Faceted ingredient ontology v3 is additive and shadow-only by default. The local
# CLI builds/stages candidates and never calls a model API. Gemini 3.5 Flash was
# selected by the frozen Copilot benchmark for proposal JSON only; deterministic
# validation plus explicit activation remain mandatory for that legacy workflow.
INGREDIENT_ONTOLOGY_V3_ENABLED=false
INGREDIENT_ONTOLOGY_V3_PROPOSAL_MODEL=gemini-3.5-flash
# Deliberately separate from the app's GEMINI_API_KEY. Leave blank when using
# the operator/Copilot export/import handoff.
INGREDIENT_ONTOLOGY_V3_PROPOSAL_API_KEY=
INGREDIENT_ONTOLOGY_V3_PROMPT_MAX_ITEMS=50
INGREDIENT_ONTOLOGY_V3_RAW_JSON_MAX_BYTES=65536
INGREDIENT_ONTOLOGY_V3_QUANTITY_SUFFICIENCY_GATE=false
# Exact lexeme identities keep unknown pantry foods distinct while allowing
# identical product and recipe labels to converge. Set false only as an
# emergency disable; new claims are created by background workers.
INGREDIENT_ONTOLOGY_EXACT_SELF_IDENTITY_ENABLED=true
INGREDIENT_ONTOLOGY_IDENTITY_ROLE_WIDENING_ENABLED=false
INGREDIENT_ONTOLOGY_IDENTITY_READINESS_V2_ENABLED=true
# Product labels use a primary language key, so "en", "en-US", and "en-GB"
# recipe locales converge while "und" and other languages remain isolated.
INGREDIENT_ONTOLOGY_PRODUCT_LANGUAGE=en
# Ingredient decision v2 queues immutable proposal artifacts immediately.
# The worker never falls back to another model and never activates ontology
# changes. Prefer the export/import handoff unless this deployed process has
# its own GEMINI_API_KEY and an operator explicitly enables worker networking.

# Autonomous ontology controller. All execution, model, and promotion gates are
# independently disabled by default. Exact user constraints remain durable;
# product/recipe ingestion subjects are recorded only when the autonomous gate
# is enabled. No model or pointer mutation occurs without its own gate.
ONTOLOGY_AUTONOMOUS_ENABLED=false
INGREDIENT_ONTOLOGY_CONTROLLER_ENABLED=false
INGREDIENT_ONTOLOGY_CONTROLLER_MODEL_ENABLED=false
INGREDIENT_ONTOLOGY_CONTROLLER_PROMOTION_ENABLED=false
INGREDIENT_ONTOLOGY_CONTROLLER_POLL_MS=250
INGREDIENT_ONTOLOGY_CONTROLLER_LOW_SIGNAL_SHORTCUT_ENABLED=false
INGREDIENT_ONTOLOGY_ABSTENTION_FOLLOWUP_ENABLED=false
INGREDIENT_ONTOLOGY_CONTROLLER_LEASE_SECONDS=600
INGREDIENT_ONTOLOGY_CONTROLLER_CRON_LIMIT=10
INGREDIENT_ONTOLOGY_CONTROLLER_MINIMUM_PRIORITY=51
INGREDIENT_ONTOLOGY_CONTROLLER_CANDIDATE_LIMIT=64
INGREDIENT_ONTOLOGY_CONTROLLER_FORK_CHUNK_ROWS=5000
INGREDIENT_ONTOLOGY_CONTROLLER_FORK_TARGET_MS=5000
INGREDIENT_ONTOLOGY_CONTROLLER_FORK_GROW_BELOW_MS=2500
INGREDIENT_ONTOLOGY_CONTROLLER_GENERATION_QUIET_SECONDS=300
INGREDIENT_ONTOLOGY_CONTROLLER_GENERATION_MAXIMUM_LATENCY_SECONDS=1800
INGREDIENT_ONTOLOGY_CONTROLLER_PROVIDER=copilot_socket
INGREDIENT_ONTOLOGY_CONTROLLER_PROPOSER_MODEL=gemini-3.7-flash
INGREDIENT_ONTOLOGY_CONTROLLER_COPILOT_SOCKET=/run/evershelf-ontology/copilot.sock
INGREDIENT_ONTOLOGY_CONTROLLER_COPILOT_TIMEOUT_SECONDS=90
INGREDIENT_ONTOLOGY_CONTROLLER_COPILOT_CONNECT_TIMEOUT_SECONDS=5
INGREDIENT_ONTOLOGY_CONTROLLER_COPILOT_READ_TIMEOUT_SECONDS=90
# Compose host-socket bind and supplementary group for the user service.
EVERSHELF_ONTOLOGY_SOCKET_DIR=/run/user/1000/evershelf-ontology
EVERSHELF_ONTOLOGY_SOCKET_GID=1000
INGREDIENT_ONTOLOGY_CONTROLLER_GOOGLE_API_KEY=
INGREDIENT_ONTOLOGY_CONTROLLER_GOOGLE_MODEL=gemini-3.7-flash
INGREDIENT_ONTOLOGY_CONTROLLER_GOOGLE_THINKING_LEVEL=medium
INGREDIENT_ONTOLOGY_CONTROLLER_CRITIC_PROVIDER=copilot_socket
INGREDIENT_ONTOLOGY_CONTROLLER_CRITIC_MODEL=claude-sonnet-5
INGREDIENT_ONTOLOGY_CONTROLLER_WAKE_SOCKET=
# Provider/model roster is data, not schema. Override only with benchmarked,
# exact model IDs and strict-schema-capable providers.
INGREDIENT_ONTOLOGY_CONTROLLER_MODEL_ROSTER_JSON=

# Copied-database activation pipeline. When enabled, the minute worker takes a
# consistent SQLite backup, deterministically consumes durable intake intents,
# emits immutable sidecars, imports them in bounded exact-ID chunks, validates
# on a copy, and publishes through one short score-pointer CAS. Candidate
# generation and shadow scoring remain forbidden on the active database.
ONTOLOGY_ACTIVATION_ENABLED=true
ONTOLOGY_ACTIVATION_DIRECTORY=/var/www/html/data/ontology-activation
ONTOLOGY_WORKER_MEMORY_LIMIT=512M
ONTOLOGY_ACTIVATION_WORKER_MEMORY_LIMIT=512M
ONTOLOGY_ACTIVATION_WORKER_SLEEP_SECONDS=2
ONTOLOGY_ACTIVATION_WORKER_FAILURE_SLEEP_SECONDS=30
RECIPE_SCORE_PRUNE_CHUNK_ROWS=1000
RECIPE_SCORE_PRUNE_MAX_CHUNKS=50
RECIPE_SCORE_WORKER_MEMORY_LIMIT=512M

# ── Cookidoo metadata connector ─────────────────────────────────────────────
# Provider detail responses may co-transport official steps. Hydration remains
# default-off and requires both connector/detail flags. The bridge returns only
# bounded allowlisted factual metadata; instructions are never returned, logged,
# or persisted.
COOKIDOO_CONNECTOR_ENABLED=false
COOKIDOO_DETAIL_HYDRATION_ENABLED=false
COOKIDOO_BRIDGE_URL=http://cookidoo-bridge:8081
COOKIDOO_BRIDGE_TOKEN=
COOKIDOO_BRIDGE_TIMEOUT_SECONDS=50
COOKIDOO_RESULT_LIMIT=20
COOKIDOO_METADATA_REFRESH_DAYS=14
# Direct-ID backfill is a separate default-off gate.
COOKIDOO_METADATA_BACKFILL_ENABLED=false
COOKIDOO_METADATA_BACKFILL_BATCH_SIZE=20
COOKIDOO_METADATA_BACKFILL_INTERVAL_SECONDS=120
COOKIDOO_METADATA_BACKFILL_JITTER_SECONDS=20
# Account-level Cookidoo My Week planner writes. This app-side gate is separate
# from the bridge gate below and is false by default. Capability is advertised
# only when the authenticated bridge also reports a known append/replace mode.
COOKIDOO_PLANNER_ENABLED=false
RECIPE_INTERACTIVE_DISCOVERY_FRESH_HOURS=24
# Disable to return only the original Cookidoo image URL.
RECIPE_COOKIDOO_THUMBNAIL_REWRITE=true
# Development/testing only, and additionally requires
# EVERSHELF_ENV=development or test. Blank or 0 reads the true active revision.
# Set one explicit ready regular faceted-v3 score revision ID to preview it
# without activation. Invalid/stale/unsealed IDs fail closed to the active
# revision; production should leave this blank.
RECIPE_SCORE_PREVIEW_REVISION_ID=
COOKIDOO_QUEUE_CADENCE_MINUTES=1
COOKIDOO_DISCOVERY_LOCALE=en-US
COOKIDOO_PERIODIC_REFRESH_ENABLED=false
# Future authorized ingestion rejects only high-confidence non-English content.
# observe records signals without rejecting; off disables content checks.
COOKIDOO_INGEST_LANGUAGE_POLICY=enforce
# Maximum periodic refresh jobs queued per cycle.
COOKIDOO_REFRESH_ENQUEUE_LIMIT=2

# ── Cleanup / retention ──────────────────────────────────────────────────────
# RECIPE_RETENTION_DAYS: delete non-favorite legacy meal plans older than N days
RECIPE_RETENTION_DAYS=7
# Normalized catalog indexing/discovery queue. Local work runs every cron cycle.
RECIPE_QUEUE_CRON_LIMIT=10
# Provider hydration jobs are skipped under current policy.
RECIPE_QUEUE_CLI_LIMIT=50
RECIPE_QUEUE_MAX_ATTEMPTS=3
RECIPE_QUEUE_LEASE_MINUTES=15
# TRANSACTION_RETENTION_DAYS: keep stock transaction history for N days.
# Smart Shopping uses this history to compute purchase frequencies.
# WARNING: values below 30 will cause the shopping list to appear nearly empty.
# Minimum enforced at runtime: 30 days.
TRANSACTION_RETENTION_DAYS=90

# ── Local Backup ─────────────────────────────────────────────────────────────
# BACKUP_ENABLED: run a daily incremental backup via cron (true/false)
BACKUP_ENABLED=true
# BACKUP_RETENTION_DAYS: keep local backups for N days (minimum 1)
BACKUP_RETENTION_DAYS=3

# ── Google Drive Backup ───────────────────────────────────────────────────────
# GDRIVE_ENABLED: upload the daily backup to Google Drive (requires a service account)
GDRIVE_ENABLED=false
#
# Setup steps:
#   1. Create a Google Cloud project and enable the Drive API
#   2. Create a Service Account and download the JSON key
#   3. Create a Drive folder and share it with the service account email
#   4. Paste the JSON content below (or set GDRIVE_SERVICE_ACCOUNT_FILE to the path)
#   5. Set GDRIVE_FOLDER_ID to the Drive folder ID (from its URL)
#
# GDRIVE_SERVICE_ACCOUNT_JSON: full JSON content of the service account key
GDRIVE_SERVICE_ACCOUNT_JSON=
# GDRIVE_SERVICE_ACCOUNT_FILE: alternative — path to the service account JSON file
GDRIVE_SERVICE_ACCOUNT_FILE=
# GDRIVE_FOLDER_ID: ID of the Drive folder where backups will be stored
GDRIVE_FOLDER_ID=
# GDRIVE_RETENTION_DAYS: delete Drive backups older than N days (0 = keep all)
GDRIVE_RETENTION_DAYS=30

# ── Security ─────────────────────────────────────────────────────────────────
# API_TOKEN: when set, all API calls require the X-API-Token header.
# SETTINGS_TOKEN: legacy alias — use API_TOKEN for new installs.
API_TOKEN=
SETTINGS_TOKEN=

# CORS_ORIGIN: comma-separated allowed origins (empty = same-origin only, no wildcard)
CORS_ORIGIN=

# GitHub automatic issue reporting (encrypted storage recommended)
# Option A — plain ( .env is gitignored ):
# GH_ISSUE_TOKEN=ghp_...
# Option B — encrypted (php scripts/encrypt-gh-token.php 'ghp_...' 'secret-key'):
GH_ISSUE_TOKEN=
GH_ISSUE_TOKEN_ENC=
GH_ISSUE_TOKEN_KEY=

# NOTE: Run `php scripts/migrate-env-security.php` once after upgrading to migrate legacy tokens.

# INSTANCE_NAME: display name for this EverShelf instance (used by the HA integration
# for Zeroconf discovery label and device name in Home Assistant).
# Defaults to the server hostname if left empty.
INSTANCE_NAME=

# ── Home Assistant Integration ────────────────────────────────────────────────
# All HA settings can also be configured from the Settings → 🏠 tab.
#
# HA_ENABLED: master switch for all HA features (webhooks, TTS, sensors)
HA_ENABLED=false
# HA_URL: base URL of your HA instance — no trailing slash
# Examples: http://homeassistant.local:8123  or  http://192.168.1.50:8123
HA_URL=
# HA_TOKEN: Long-Lived Access Token (HA Profile → Security → Long-Lived Access Tokens)
HA_TOKEN=
# HA_TTS_ENTITY: media_player entity for recipe step TTS (e.g. media_player.living_room)
HA_TTS_ENTITY=
# HA_WEBHOOK_ID: ID of an HA automation's Webhook trigger
HA_WEBHOOK_ID=
# HA_WEBHOOK_EVENTS: comma-separated events to fire webhooks for
#   Available: expiry, shopping_add, stock_update, barcode_scan
HA_WEBHOOK_EVENTS=expiry,shopping_add,stock_update
# HA_NOTIFY_SERVICE: HA notify service for push alerts (e.g. notify.mobile_app_my_phone)
HA_NOTIFY_SERVICE=
# HA_EXPIRY_DAYS: days before expiry to trigger expiry alert (default 3)
HA_EXPIRY_DAYS=3

# ── Developer / demo ─────────────────────────────────────────────────────────
# DEMO_MODE: when true, all write operations are blocked (for public demos)
DEMO_MODE=false

# CRON_LOG_MAX_BYTES: rotate data/cron.log when larger (default 524288 = 512 KB)
CRON_LOG_MAX_BYTES=524288

# Application request/AI/query logging (stored under the persistent data volume)
# LOG_LEVEL: DEBUG, INFO, WARN, or ERROR
LOG_LEVEL=INFO
LOG_ROTATE_HOURS=24
LOG_MAX_FILES=14
# LOG_DIR=/var/www/html/data/logs
